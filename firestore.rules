rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Une table = une session. Seul l'appareil hôte qui l'a créée peut l'écrire.
    match /tables/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
      allow update: if request.auth != null
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      // Présence des téléphones : chacun n'écrit que sa propre fiche.
      match /presence/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid
          && (request.resource == null || request.resource.data.json.size() < 4000);
      }
    }
  }
}
